{
  "name": "codemux",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "Unified CLI for AI coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bindsch/codemux.git"
  },
  "bugs": {
    "url": "https://github.com/bindsch/codemux/issues"
  },
  "homepage": "https://github.com/bindsch/codemux#readme",
  "type": "module",
  "bin": {
    "codemux": "./bin/codemux"
  },
  "scripts": {
    "start": "bun --no-env-file --no-install --config=./bunfig.runtime.toml run src/index.ts",
    "test": "bun test --max-concurrency=1",
    "test:coverage": "bun test --max-concurrency=1 --coverage --coverage-reporter=text --coverage-reporter=lcov && bun run scripts/check-source-coverage.ts",
    "test:contracts": "CODEMUX_RUN_INSTALLED_CONTRACTS=1 bun test --max-concurrency=1 tests/installed-contract.test.ts",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "check": "bun run typecheck && bun run test:coverage",
    "smoke": "./bin/codemux --help >/dev/null && ./bin/codemux --version && ./bin/codemux list >/dev/null && ./bin/codemux autonomy >/dev/null && ./bin/codemux verify >/dev/null && ./bin/codemux verify --show-scode >/dev/null",
    "link": "bun link",
    "unlink": "bun unlink"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "js-yaml": "^4.3.0"
  }
}
